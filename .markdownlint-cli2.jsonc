{
  // Rule settings, target globs and ignores all live here. cli2 reads only
  // this file — a .markdownlint.jsonc or .markdownlintignore is silently
  // ignored.
  "config": {
    // Prose wraps at 80; tables and code blocks are exempt because breaking
    // them to fit costs more readability than it buys.
    "MD013": {
      "line_length": 80,
      "tables": false,
      "code_blocks": false
    },
    // Go is tab-indented by gofmt, so embedded Go must keep its tabs.
    "MD010": {
      "code_blocks": false
    }
  },
  "globs": ["**/*.md"],
  "ignores": [
    // Generated by tfplugindocs; its output is verified by the docs-drift
    // check in CI, not by prose linting.
    "docs/index.md",
    "docs/resources/**",
    "docs/data-sources/**",
    // Working notes from the SDD run, not published documentation.
    ".superpowers/**",
    "node_modules/**"
  ]
}
