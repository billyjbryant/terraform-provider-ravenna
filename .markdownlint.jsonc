{
  // Prose wraps at 80; tables and code blocks are exempt because breaking them
  // to fit costs more readability than it buys.
  "MD013": {
    "line_length": 80,
    "tables": false,
    "code_blocks": false
  },
  // Go is tab-indented by gofmt, so embedded Go must keep its tabs.
  "MD010": {
    "code_blocks": false
  }
}
